# ============================================
# Royal Brothers Fitness Gym - Environment Variables
# Copy this file to ".env" for local development and fill in real
# values. NEVER commit the real ".env" file to version control.
#
# In production (Render / Railway / Vercel), set these as actual
# environment variables in the platform's dashboard instead of
# uploading a .env file.
# ============================================

# ---------- Flask ----------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string

# ---------- MySQL Database ----------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=royal_brothers_gym
DB_PORT=3306

# ---------- Gmail SMTP ----------
# Do NOT use your normal Gmail password.
# Generate a Gmail "App Password" at:
#   Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=replace-with-a-16-character-app-password
MAIL_SENDER_NAME=Royal Brothers Fitness Gym

# ---------- App URL ----------
# Used to build the links inside verification/reset emails.
# Use your real deployed domain in production. Leave blank to
# auto-detect from the incoming request during local development.
APP_BASE_URL=http://127.0.0.1:5000
